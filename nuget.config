<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ============================================================================== -->
  <!-- CGPDI.StudyLab — Configuração de Segurança contra Ataques na Cadeia NuGet      -->
  <!-- ============================================================================== -->

  <!-- 1. FONTES AUTORIZADAS (Limpa fontes arbitrárias ou locais não confiáveis) -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- 2. MAPEAMENTO ESTRITO DE PACOTES (Prevenção de Dependency Confusion) -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- 3. AUDITORIA E VALIDAÇÃO DE ASSINATURAS DIGITAIS -->
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
