<Window x:Class="CGPDI.StudyLab.Views.ProjectStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CGPDI.StudyLab.Views"
        mc:Ignorable="d"
        Title="CGPDI StudyLab — Estúdio de Projetos Dedicado (C# &amp; WPF)"
        Height="850" Width="1350" MinHeight="600" MinWidth="950"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown"
        Background="#080A10" Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Título Customizada -->
            <RowDefinition Height="*"/>    <!-- Estúdio Control -->
        </Grid.RowDefinitions>

        <!-- Barra de Título Customizada -->
        <Border Grid.Row="0" Background="#101422" BorderBrush="#1E2638" BorderThickness="0,0,0,1" Padding="10,6" MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título e Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 4,2 L 1,6 L 4,10 M 8,2 L 11,6 L 8,10 M 7,1 L 5,11" Stroke="#38BDF8" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ESTÚDIO DE PROJETOS DEDICADO" Foreground="#F8FAFC" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text=".NET 10 • ROSLYN &amp; XAML" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Botões de Controle de Janela -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗕" Click="BtnMinimize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="#182032" Foreground="#94A3B8" BorderBrush="#252F46" ToolTip="Minimizar"/>
                    <Button x:Name="BtnMaximize" Content="🗖" Click="BtnMaximize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="#182032" Foreground="#94A3B8" BorderBrush="#252F46" ToolTip="Maximizar/Restaurar"/>
                    <Button Content="✕" Click="BtnClose_Click" Width="32" Height="26" Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#991B1B" FontWeight="Bold" ToolTip="Fechar"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Estúdio de Projetos Embutido -->
        <views:ProjectStudioControl x:Name="StudioControl" Grid.Row="1"/>
    </Grid>
</Window>
