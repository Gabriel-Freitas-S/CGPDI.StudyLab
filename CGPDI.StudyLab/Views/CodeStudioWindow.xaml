<Window x:Class="CGPDI.StudyLab.Views.CodeStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CGPDI StudyLab — Laboratório C# &amp; WPF (Janela Dedicada)"
        Height="850" Width="1360" MinHeight="600" MinWidth="950"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown"
        Background="#08080E" Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#242436"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E1E2C"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#33334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E44"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4F4F72"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#181824"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#090C16"/>
            <Setter Property="BorderBrush" Value="#1C2438"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#101422"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#1C2438"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#182034"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#172238"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#38BDF8"/>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#181826"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Título Customizada -->
            <RowDefinition Height="*"/>    <!-- 3-Column Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Barra de Título Customizada -->
        <Border Grid.Row="0" Background="#10101A" BorderBrush="#222232" BorderThickness="0,0,0,1" Padding="10,6" MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 4,2 L 1,6 L 4,10 M 8,2 L 11,6 L 8,10 M 7,1 L 5,11" Stroke="#38BDF8" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LABORATÓRIO C# &amp; WPF" Foreground="#60A5FA" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStudioLessonHeader" Text="Trilha Interativa: 12 Lições" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Ações do Laboratório -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnStudioToggleTrack" Content="Trilha" Click="BtnStudioToggleTrack_Click" Padding="8,3" FontSize="11" Margin="0,0,3,0" ToolTip="Ocultar/Exibir Trilha de Estudos"/>
                    <Button x:Name="BtnStudioToggleCanvas" Content="Visualizador" Click="BtnStudioToggleCanvas_Click" Padding="8,3" FontSize="11" Margin="0,0,3,0" ToolTip="Ocultar/Exibir Painel Visual"/>
                    <Button Content="Modo Foco" Click="BtnStudioFocusCode_Click" Style="{StaticResource LabPrimaryButton}" Padding="8,3" FontSize="11" Margin="0,0,3,0" ToolTip="100% largura para o código"/>
                    <Button Content="Restaurar Painéis" Click="BtnStudioResetPanels_Click" Padding="8,3" FontSize="11" ToolTip="Restaurar layout balanceado"/>
                </StackPanel>

                <!-- Botões de Janela -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗕" Click="BtnMinimize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="#182032" Foreground="#94A3B8" BorderBrush="#252F46" ToolTip="Minimizar"/>
                    <Button x:Name="BtnMaximize" Content="🗖" Click="BtnMaximize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="#182032" Foreground="#94A3B8" BorderBrush="#252F46" ToolTip="Maximizar/Restaurar"/>
                    <Button Content="✕" Click="BtnClose_Click" Width="32" Height="26" Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#991B1B" FontWeight="Bold" ToolTip="Fechar"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3 Colunas: Trilha/Quiz -> Playground/Visualizador -> Editor -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColStudioTrack" Width="380" MinWidth="0" MaxWidth="550"/>
                <ColumnDefinition x:Name="ColStudioSplitter1" Width="5"/>
                <ColumnDefinition x:Name="ColStudioCanvas" Width="420" MinWidth="0" MaxWidth="650"/>
                <ColumnDefinition x:Name="ColStudioSplitter2" Width="5"/>
                <ColumnDefinition x:Name="ColStudioCode" Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- COLUNA 1: Trilha de Estudos & Quiz em Destaque -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170" MinHeight="100"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de Progresso da Trilha -->
                <Border Grid.Row="0" Background="#141424" BorderBrush="#25253A" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5" Padding="8,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,3">
                            <TextBlock x:Name="TxtStudioProgress" Text="Progresso: 1 de 12 (8%)" Foreground="#93C5FD" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStudioModule" Text="FUNDAMENTOS" Foreground="#60A5FA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="PbStudioProgress" Minimum="1" Maximum="12" Value="1" Height="6" Foreground="#3B82F6" Background="#222234" BorderThickness="0" Margin="0,0,0,5"/>
                        <UniformGrid Columns="2">
                            <Button Content="Anterior" Click="BtnStudioPrevLesson_Click" Padding="6,3" FontSize="11"/>
                            <Button Content="Próximo" Click="BtnStudioNextLesson_Click" Style="{StaticResource LabPrimaryButton}" Padding="6,3" FontSize="11" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Lista de 12 Lições -->
                <ListBox x:Name="LstStudioLessons" Grid.Row="1" Background="#0E0E16" BorderBrush="#222232" BorderThickness="1" Margin="0,0,0,5"
                         SelectionChanged="LstStudioLessons_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" Margin="0,1" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Module}" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Teoria & Quiz Interativo Sem Corte de Texto -->
                <GroupBox Grid.Row="2" Header="Conceito e Quiz de Fixação">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                        <StackPanel>
                            <TextBlock x:Name="TxtStudioLessonTitle" Text="Título da Lição" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,3" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStudioLessonSummary" Text="Resumo prático..." Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8"/>

                            <Border Background="#161626" BorderBrush="#2D2D44" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Quiz de Fixação:" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtStudioQuizQuestion" Text="Pergunta..." Foreground="#F8FAFC" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,8" FontWeight="SemiBold"/>

                                    <Button x:Name="BtnStudioQuizOpt0" Click="BtnStudioQuizOption_Click" Tag="0" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="8,6" MinHeight="36">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="11.5" HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button x:Name="BtnStudioQuizOpt1" Click="BtnStudioQuizOption_Click" Tag="1" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="8,6" MinHeight="36">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="11.5" HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button x:Name="BtnStudioQuizOpt2" Click="BtnStudioQuizOption_Click" Tag="2" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="8,6" MinHeight="36">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="11.5" HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Border x:Name="BrdStudioQuizFeedback" Visibility="Collapsed" CornerRadius="4" Padding="8,6" Margin="0,6,0,0" Background="#1E2A20" BorderBrush="#2E7D32" BorderThickness="1">
                                        <TextBlock x:Name="TxtStudioQuizFeedback" Text="Feedback..." Foreground="#A5D6A7" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Documentação Oficial Microsoft Learn:" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" Margin="0,2,0,3"/>
                            <ItemsControl x:Name="IcStudioMsRefs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#12121E" BorderBrush="#242436" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Foreground="#60A5FA" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Abrir" Tag="{Binding Url}" Click="BtnOpenMsRef_Click" Padding="6,2" FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <GridSplitter x:Name="StudioSplitter1" Grid.Column="1"/>

            <!-- COLUNA 2: Playground & Visualizador em Tempo Real -->
            <Border Grid.Column="2" Background="#0C0C12" BorderBrush="#20202C" BorderThickness="1" CornerRadius="6" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Playground Interativo (Parâmetros)" Margin="0,0,0,6">
                        <StackPanel>
                            <Grid Margin="0,1,0,1">
                                <TextBlock x:Name="TxtStudioParam1" Text="Parâmetro 1:" Foreground="#E2E8F0" FontSize="11.5"/>
                                <TextBlock x:Name="TxtStudioVal1" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderStudio1" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderStudio_ValueChanged" Height="22"/>

                            <Grid Margin="0,1,0,1">
                                <TextBlock x:Name="TxtStudioParam2" Text="Parâmetro 2:" Foreground="#E2E8F0" FontSize="11.5"/>
                                <TextBlock x:Name="TxtStudioVal2" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderStudio2" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderStudio_ValueChanged" Height="22"/>

                            <Grid Margin="0,1,0,1">
                                <TextBlock x:Name="TxtStudioParam3" Text="Parâmetro 3:" Foreground="#E2E8F0" FontSize="11.5"/>
                                <TextBlock x:Name="TxtStudioVal3" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderStudio3" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderStudio_ValueChanged" Height="22"/>

                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <Button Content="Passo" Click="BtnStudioStep_Click" Style="{StaticResource LabPrimaryButton}" Padding="4,4" FontSize="11" Margin="0,0,2,0"/>
                                <Button Content="Executar Tudo" Click="BtnStudioRunAll_Click" Padding="4,4" FontSize="11" Margin="2,0,2,0"/>
                                <Button Content="Resetar" Click="BtnStudioResetSim_Click" Padding="4,4" FontSize="11" Margin="2,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <TabControl x:Name="TabStudioVisualizer" Grid.Row="1" Background="#0A0A10" BorderBrush="#242436">
                        <TabItem Header="Canvas de Memória">
                            <Border Background="#06060A" Padding="4">
                                <Image x:Name="ImgStudioSimulation" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </TabItem>
                        <TabItem x:Name="TabItemStudioLiveXaml" Header="WPF Nativo ao Vivo">
                            <Border Background="#0D0D18" Padding="6" CornerRadius="4">
                                <Border x:Name="PnlStudioLiveXamlContainer" BorderBrush="#33334D" BorderThickness="1" CornerRadius="6" Background="#141424" Padding="8">
                                    <TextBlock Text="O controle WPF dinâmico será renderizado aqui." Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter x:Name="StudioSplitter2" Grid.Column="3"/>

            <!-- COLUNA 3: Editor de Código & Testes Automatizados -->
            <TabControl x:Name="TabStudioEditor" Grid.Column="4" Background="#101018" BorderBrush="#2A2A3C">
                <!-- Aba 1: Editor C# -->
                <TabItem Header="Código C# (.cs)">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="130" MinHeight="80"/>
                        </Grid.RowDefinitions>

                        <!-- Missão da Lição -->
                        <Border Grid.Row="0" Background="#141E2C" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="MISSÃO PRÁTICA:" Foreground="#60A5FA" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtStudioChallengeGoal" Text="Implemente a rotina..." Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Toolbar -->
                        <Border Grid.Row="1" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Compilar e Executar" Click="BtnStudioRunCode_Click" Style="{StaticResource LabPrimaryButton}" Padding="8,4" FontSize="11.5" Margin="0,0,4,2"/>
                                <Button Content="Executar Testes" Click="BtnStudioRunTests_Click" Padding="8,4" FontSize="11.5" Margin="0,0,4,2"/>
                                <Button Content="Carregar Gabarito" Click="BtnStudioGabarito_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                                <Button Content="Restaurar Template" Click="BtnStudioStarter_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                            </WrapPanel>
                        </Border>

                        <!-- RichTextBox Editor C# -->
                        <Border Grid.Row="2" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                            <RichTextBox x:Name="RtbStudioEditableCode" Background="Transparent" Foreground="#F8FAFC"
                                         BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" AcceptsTab="True" CaretBrush="#38BDF8"
                                         SelectionBrush="#2563EB" SelectionOpacity="0.7"/>
                        </Border>

                        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch"/>

                        <!-- Relatório de Testes -->
                        <GroupBox Grid.Row="4" Header="Relatório de Testes Automatizados e Roslyn">
                            <TextBox x:Name="TxtStudioCompilerReport" IsReadOnly="True" Background="#06060A" Foreground="#A5D6A7" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"/>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- Aba 2: Marcação WPF / XAML -->
                <TabItem Header="Marcação WPF (.xaml)">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Renderizar XAML" Click="BtnStudioRenderXaml_Click" Style="{StaticResource LabPrimaryButton}" Padding="8,4" FontSize="11.5" Margin="0,0,4,2"/>
                                <Button Content="Copiar XAML" Click="BtnStudioCopyXaml_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                            <RichTextBox x:Name="RtbStudioXamlCode" Background="Transparent" Foreground="#9CDCFE"
                                         BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" AcceptsTab="True" CaretBrush="#38BDF8"
                                         SelectionBrush="#2563EB" SelectionOpacity="0.7"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Aba 3: Estudo e Gabarito Oficial -->
                <TabItem Header="Estudo e Gabarito">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="120"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="3*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                            <Button Content="Copiar Código C#" Click="BtnStudioCopyOfficial_Click" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/>
                        </Border>

                        <Border Grid.Row="1" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                            <RichTextBox x:Name="RtbStudioCode" IsReadOnly="True" Background="Transparent" Foreground="#86EFAC" BorderThickness="0"
                                         FontFamily="Consolas, Cascadia Code" FontSize="12.5" VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"/>

                        <GroupBox Grid.Row="3" Header="Explicação Linha a Linha">
                            <TextBox x:Name="TxtStudioExplanation" IsReadOnly="True" Background="#0A0A12" Foreground="#F1F5F9" BorderThickness="0"
                                     FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"/>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- Aba 4: Console RAM -->
                <TabItem Header="Console da RAM">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                            <Button Content="Copiar Logs" Click="BtnStudioCopyConsole_Click" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/>
                        </Border>

                        <Border Grid.Row="1" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                            <TextBox x:Name="TxtStudioConsole" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#14141C" BorderBrush="#242432" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStudioStatus" Text="Laboratório pronto. Lição carregada." Foreground="#40E0D0" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" x:Name="TxtStudioStats" Text="Tempo: 0.0 ms • Resolução: 512×512" Foreground="#94A3B8" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
