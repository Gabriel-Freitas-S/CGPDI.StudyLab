<Window x:Class="CGPDI.StudyLab.Views.CodeStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CGPDI StudyLab — Estúdio de Código C#, Testes &amp; Laboratório Guiado"
        Height="760" Width="1240" MinHeight="500" MinWidth="800"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown"
        Background="#08080E" Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo Dark para GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#242436"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Estilo Dark para Botões -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E1E2C"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#33334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E44"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4F4F72"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#181824"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StudioSuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Estilo Dark para Abas (TabItem) -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#14141E"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#20202C"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}"
                                Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E1E2E"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para GridSplitter -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#141420"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="5">
                            <Rectangle Width="2" Fill="#242436" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Main Studio Workspace (3 Columns) -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Bar com Identidade Visual, Arraste Livre com Mouse e Ações Globais Sem Sobreposição -->
        <Border Grid.Row="0" Background="#10101A" BorderBrush="#222232" BorderThickness="0,0,0,1" Padding="10,5"
                MouseLeftButtonDown="TopBar_MouseDown">
            <DockPanel LastChildFill="True">
                <!-- Esquerda: Logo Vetorial SVG/XAML, Badge e Título com Trimming Seguro -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="64" Height="64">
                            <!-- Face Superior (Ciano) -->
                            <Path Data="M 32,8 L 54,20 L 32,32 L 10,20 Z" Fill="#38BDF8" Stroke="#67E8F9" StrokeThickness="1.5"/>
                            <!-- Face Esquerda (Magenta) -->
                            <Path Data="M 10,20 L 32,32 L 32,56 L 10,44 Z" Fill="#EC4899" Stroke="#F472B6" StrokeThickness="1.5"/>
                            <!-- Face Direita (Ouro/Âmbar) -->
                            <Path Data="M 32,32 L 54,20 L 54,44 L 32,56 Z" Fill="#FBBF24" Stroke="#FCD34D" StrokeThickness="1.5"/>
                            <!-- Pixel Grid Interno -->
                            <Path Data="M 32,14 L 38,17.5 L 32,21 L 26,17.5 Z" Fill="#E0F2FE"/>
                            <Path Data="M 16,28 L 22,31.5 L 22,38.5 L 16,35 Z" Fill="#BE185D"/>
                            <Path Data="M 42,31.5 L 48,28 L 48,35 L 42,38.5 Z" Fill="#D97706"/>
                            <!-- Vértice Central Brilhante -->
                            <Ellipse Canvas.Left="29.5" Canvas.Top="29.5" Width="5" Height="5" Fill="#FFFFFF"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="CGPDI STUDYLAB" Foreground="#60A5FA" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MODO ESTÚDIO" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="TxtTopLessonTitle" Text="[Passo 1/12] ..." Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Direita: Navegação e Controles da Janela -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬅️ Anterior" Click="BtnPrev_Click" Padding="6,3" Margin="0,0,3,0"/>
                    <Button Content="Próximo ➡️" Click="BtnNext_Click" Style="{StaticResource StudioPrimaryButton}" Padding="6,3" Margin="0,0,8,0"/>
                    <Button Content="🗕" Click="BtnMinimize_Click" Padding="8,3" Margin="0,0,2,0" ToolTip="Minimizar"/>
                    <Button x:Name="BtnStudioMaximize" Content="🗖" Click="BtnToggleMaximize_Click" Padding="8,3" Margin="0,0,2,0" ToolTip="Maximizar/Restaurar"/>
                    <Button Content="❌" Click="BtnClose_Click" Padding="8,3" ToolTip="Fechar Estúdio (Esc)"/>
                </StackPanel>

                <!-- Centro: Botões de Controle de Painéis (Recolher/Expandir) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnStudioToggleTrack" Content="◀ Trilha" Click="BtnStudioToggleTrack_Click" Padding="6,2" FontSize="11" Margin="0,0,3,0" ToolTip="Ocultar/Exibir Trilha"/>
                    <Button x:Name="BtnStudioToggleCanvas" Content="◀ Canvas" Click="BtnStudioToggleCanvas_Click" Padding="6,2" FontSize="11" Margin="0,0,3,0" ToolTip="Ocultar/Exibir Canvas"/>
                    <Button Content="🗖 Modo Foco" Click="BtnStudioFocusCode_Click" Style="{StaticResource StudioPrimaryButton}" Padding="6,2" FontSize="11" Margin="0,0,3,0" ToolTip="100% largura para o código"/>
                    <Button Content="🔄 Restaurar" Click="BtnStudioResetPanels_Click" Padding="6,2" FontSize="11" ToolTip="Restaurar os 3 painéis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Área Principal de Trabalho (3 Colunas com GridSplitters e Colunas Ocultáveis) -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColStudioTrack" Width="410" MinWidth="0" MaxWidth="650"/>
                <ColumnDefinition x:Name="ColStudioSplitter1" Width="5"/>
                <ColumnDefinition x:Name="ColStudioCode" Width="*" MinWidth="300"/>
                <ColumnDefinition x:Name="ColStudioSplitter2" Width="5"/>
                <ColumnDefinition x:Name="ColStudioCanvas" Width="430" MinWidth="0" MaxWidth="600"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================================================== -->
            <!-- COLUNA 1: Trilha de Aprendizado + Teoria + Explicações + Quiz                     -->
            <!-- ================================================================================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Progresso -->
                    <RowDefinition Height="180" MinHeight="120"/> <!-- Lista de Lições -->
                    <RowDefinition Height="*"/> <!-- TabControl de Teoria / Quiz / Referências -->
                </Grid.RowDefinitions>

                <!-- Barra de Progresso e Navegação Rápida -->
                <Border Grid.Row="0" Background="#141420" BorderBrush="#252538" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5" Padding="8,5">
                    <StackPanel>
                        <Grid Margin="0,0,0,3">
                            <TextBlock x:Name="TxtStudioProgressHeader" Text="Trilha de Estudos (Passo 1 de 12)" Foreground="#60A5FA" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStudioPercent" Text="8%" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold"/>
                        </Grid>
                        <ProgressBar x:Name="PbStudioProgress" Minimum="1" Maximum="12" Value="1" Height="6" Foreground="#2563EB" Background="#222234" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Lista de 12 Lições -->
                <ListBox x:Name="LstStudioLessons" Grid.Row="1" Background="#0E0E16" BorderBrush="#222232" BorderThickness="1" Margin="0,0,0,5"
                         SelectionChanged="LstStudioLessons_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" Margin="0,1" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Module}" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="Padding" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#222234"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Abas de Conteúdo Pedagógico Dark -->
                <TabControl Grid.Row="2" Background="#101018" BorderBrush="#252538">
                    <!-- Aba 1: Teoria & Fórmulas -->
                    <TabItem Header="📖 Teoria">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                            <StackPanel>
                                <Border Background="#141E2C" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtStudioSummary" Text="Resumo prático da lição..." Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                </Border>
                                <TextBox x:Name="TxtStudioTheory" IsReadOnly="True" Background="#0A0A12" Foreground="#F1F5F9" BorderThickness="0"
                                         FontSize="12" TextWrapping="Wrap" Padding="5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Aba 2: Gabarito Oficial & Explicação Linha a Linha -->
                    <TabItem Header="💡 Gabarito">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                            <StackPanel>
                                <GroupBox Header="💻 Solução Oficial C#">
                                    <TextBox x:Name="TxtStudioOfficialCode" IsReadOnly="True" Background="#06060A" Foreground="#86EFAC" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Padding="5"/>
                                </GroupBox>
                                <GroupBox Header="🔍 Análise Passo a Passo">
                                    <TextBox x:Name="TxtStudioExplanation" IsReadOnly="True" Background="#0A0A12" Foreground="#F1F5F9" BorderThickness="0"
                                             FontSize="11.5" TextWrapping="Wrap" Padding="5"/>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Aba 3: Quiz de Fixação -->
                    <TabItem Header="❓ Quiz">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="5">
                            <StackPanel>
                                <TextBlock x:Name="TxtStudioQuizQuestion" Text="Pergunta do Quiz..." Foreground="#FFFFFF" FontSize="13" TextWrapping="Wrap" FontWeight="SemiBold" LineHeight="18" Margin="0,0,0,8"/>
                                
                                <Button x:Name="BtnStudioQuiz0" Content="Opção A" Click="BtnStudioQuizOption_Click" Tag="0" Margin="0,4" HorizontalContentAlignment="Stretch" Padding="10,8" FontSize="12" MinHeight="38">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="17" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button x:Name="BtnStudioQuiz1" Content="Opção B" Click="BtnStudioQuizOption_Click" Tag="1" Margin="0,4" HorizontalContentAlignment="Stretch" Padding="10,8" FontSize="12" MinHeight="38">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="17" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button x:Name="BtnStudioQuiz2" Content="Opção C" Click="BtnStudioQuizOption_Click" Tag="2" Margin="0,4" HorizontalContentAlignment="Stretch" Padding="10,8" FontSize="12" MinHeight="38">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="17" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Border x:Name="BrdStudioQuizFeedback" Visibility="Collapsed" CornerRadius="4" Padding="8,6" Margin="0,8,0,0" Background="#1E2A20" BorderBrush="#2E7D32" BorderThickness="1">
                                    <TextBlock x:Name="TxtStudioQuizFeedback" Text="Feedback..." Foreground="#A5D6A7" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Aba 4: Microsoft Learn -->
                    <TabItem Header="📚 Docs MS">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                            <ItemsControl x:Name="IcStudioMsRefs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141420" BorderBrush="#252538" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="#60A5FA" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                                <Button Content="🌐 Abrir Documentação" Tag="{Binding Url}" Click="BtnOpenMsRef_Click" HorizontalAlignment="Left" Padding="6,2" FontSize="10.5"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter x:Name="SplitterStudio1" Grid.Column="1"/>

            <!-- ================================================================================== -->
            <!-- COLUNA 2: Editor C# Interativo com Roslyn & Painel de Testes                      -->
            <!-- ================================================================================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Missão -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar Responsiva -->
                    <RowDefinition Height="*"/>    <!-- Editor C# -->
                    <RowDefinition Height="5"/>    <!-- Splitter -->
                    <RowDefinition Height="180" MinHeight="100"/> <!-- Resultados de Teste -->
                </Grid.RowDefinitions>

                <!-- Banner da Missão de Programação -->
                <Border Grid.Row="0" Background="#121C2C" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="🎯 SUA MISSÃO DE PROGRAMAÇÃO (ESCREVA DO ZERO OU USE TEMPLATES):" Foreground="#60A5FA" FontSize="10.5" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStudioGoal" Text="Implemente a função..." Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Toolbar de Ação do Editor Responsiva (Sem Sobreposição) -->
                <Border Grid.Row="1" Background="#161622" BorderBrush="#252538" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnStudioCompileRun" Content="🚀 Compilar &amp; Executar" Click="BtnStudioCompileRun_Click" Style="{StaticResource StudioSuccessButton}" Padding="9,4" FontSize="11.5" Margin="0,0,4,3" ToolTip="Compila com Roslyn e renderiza no Canvas"/>
                        <Button x:Name="BtnStudioRunTests" Content="🧪 Rodar Testes" Click="BtnStudioRunTests_Click" Style="{StaticResource StudioPrimaryButton}" Padding="8,4" FontSize="11.5" Margin="0,0,4,3" ToolTip="Executa a bateria de testes unitários automatizados"/>
                        <Button Content="🔄 Carregar Gabarito Oficial" Click="BtnStudioRestoreSolution_Click" Padding="8,4" FontSize="11" Margin="0,0,4,3" Background="#1E3A5F" BorderBrush="#3B82F6" Foreground="#93C5FD" FontWeight="Bold" ToolTip="Substitui o editor pelo gabarito oficial completo"/>
                        <Button Content="💡 Template" Click="BtnStudioStarterCode_Click" Padding="6,4" FontSize="11" Margin="0,0,4,3" ToolTip="Carrega assinatura e dicas TODO"/>
                        <Button Content="✨ Em Branco" Click="BtnStudioBlankCode_Click" Padding="6,4" FontSize="11" Margin="0,0,6,3" ToolTip="Limpa para você escrever 100% do zero"/>
                        <Button Content="🔍 A-" Click="BtnStudioZoomOut_Click" Padding="6,3" FontSize="11" Margin="0,0,3,3" ToolTip="Diminuir fonte"/>
                        <Button Content="🔍 A+" Click="BtnStudioZoomIn_Click" Padding="6,3" FontSize="11" Margin="0,0,3,3" ToolTip="Aumentar fonte"/>
                        <Button Content="📋 Copiar" Click="BtnStudioCopyCode_Click" Padding="6,3" FontSize="11" Margin="0,0,0,3" ToolTip="Copiar código"/>
                    </WrapPanel>
                </Border>

                <!-- Editor de Código C# Espaçoso -->
                <Border Grid.Row="2" Background="#06060A" BorderBrush="#1C1C2C" BorderThickness="1" CornerRadius="4" Padding="8">
                    <TextBox x:Name="TxtStudioEditableCode" AcceptsReturn="True" AcceptsTab="True" Background="Transparent" Foreground="#F8FAFC"
                             BorderThickness="0" FontFamily="Consolas" FontSize="14.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             CaretBrush="#38BDF8"/>
                </Border>

                <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch"/>

                <!-- Relatório dos Testes Automatizados & Roslyn -->
                <GroupBox Grid.Row="4" Header="🧪 Relatório de Testes Automatizados &amp; Compilação (Microsoft Roslyn)">
                    <TextBox x:Name="TxtStudioTestReport" IsReadOnly="True" Background="#06060A" Foreground="#A5D6A7" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"/>
                </GroupBox>
            </Grid>

            <GridSplitter x:Name="SplitterStudio2" Grid.Column="3"/>

            <!-- ================================================================================== -->
            <!-- COLUNA 3: Canvas Gráfico em Tempo Real + Sliders + Console da RAM                 -->
            <!-- ================================================================================== -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Sliders do Playground -->
                    <RowDefinition Height="3*" MinHeight="180"/> <!-- Canvas -->
                    <RowDefinition Height="5"/>    <!-- Splitter -->
                    <RowDefinition Height="2*" MinHeight="100"/> <!-- Console de Memória -->
                </Grid.RowDefinitions>

                <!-- Playground com Sliders e Badges -->
                <GroupBox Grid.Row="0" Header="🧪 Playground Interativo (Experimentação Manual)">
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,4">
                            <Grid Margin="0,1,0,1">
                                <TextBlock x:Name="TxtStudioParam1" Text="Parâmetro 1:" Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtStudioVal1" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderStudio1" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderStudio_ValueChanged" Height="22" Margin="0,0,0,3"/>

                            <Grid Margin="0,1,0,1">
                                <TextBlock x:Name="TxtStudioParam2" Text="Parâmetro 2:" Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtStudioVal2" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderStudio2" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderStudio_ValueChanged" Height="22" Margin="0,0,0,3"/>

                            <Grid Margin="0,1,0,1">
                                <TextBlock x:Name="TxtStudioParam3" Text="Parâmetro 3:" Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtStudioVal3" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderStudio3" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderStudio_ValueChanged" Height="22" Margin="0,0,0,2"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,2,0,0">
                            <Button Content="▶️ Passo" Click="BtnStudioStep_Click" Style="{StaticResource StudioPrimaryButton}" Padding="3,4" FontSize="11" Margin="0,0,2,0"/>
                            <Button Content="⚡ Completo" Click="BtnStudioRunAll_Click" Padding="3,4" FontSize="11" Margin="2,0,2,0"/>
                            <Button Content="🔄 Reset" Click="BtnStudioReset_Click" Padding="3,4" FontSize="11" Margin="2,0,0,0"/>
                        </UniformGrid>
                    </Grid>
                </GroupBox>

                <!-- Canvas Gráfico (DirectBitmap) -->
                <Border Grid.Row="1" Background="#06060A" BorderBrush="#222234" BorderThickness="1" CornerRadius="4" Padding="4">
                    <Grid>
                        <Image x:Name="ImgStudioSimulation" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"/>

                <!-- Console de Inspeção da Memória RAM -->
                <GroupBox Grid.Row="3" Header="🖥️ Console de Inspeção da Memória RAM &amp; Registradores">
                    <TextBox x:Name="TxtStudioRamConsole" IsReadOnly="True" Background="#06060A" Foreground="#38BDF8" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="5"/>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Barra de Status Inferior -->
        <Border Grid.Row="2" Background="#0E0E16" BorderBrush="#1C1C2A" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <TextBlock x:Name="TxtStudioStatus" Text="Estúdio pronto para uso. Selecione uma lição ou escreva o algoritmo para testar." Foreground="#94A3B8" FontSize="11.5"/>
                <TextBlock Text="⚡ Compilador Roslyn em Memória • .NET 10 WPF" HorizontalAlignment="Right" Foreground="#64748B" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
