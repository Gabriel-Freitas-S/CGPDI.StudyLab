<UserControl x:Class="CGPDI.StudyLab.Views.ProjectStudioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#080A10" Foreground="#E2E8F0"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Cores do Tema Escuro Moderno -->
        <SolidColorBrush x:Key="BgDark" Color="#080A10"/>
        <SolidColorBrush x:Key="BgCard" Color="#0E121E"/>
        <SolidColorBrush x:Key="BgCardHeader" Color="#131828"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1E2638"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2D384E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>

        <!-- Estilo de GroupBox Moderno -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#1E2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="#0E121E" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#131828" BorderBrush="#1E2638" BorderThickness="0,0,0,1"
                                        CornerRadius="4,4,0,0" Padding="8,5" Margin="-6,-6,-6,6">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </Border>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Geral de Botões -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#151A2A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#252F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#222B42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0E1320"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioExecButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StudioAccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#090C16"/>
            <Setter Property="BorderBrush" Value="#1C2438"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#101422"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#1C2438"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#182034"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#172238"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#151B2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Studio Header Bar -->
            <RowDefinition Height="*"/>    <!-- 3-Column Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status HUD -->
        </Grid.RowDefinitions>

        <!-- Barra Superior do Estúdio -->
        <Border Grid.Row="0" Background="#101422" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 4,2 L 1,6 L 4,10 M 8,2 L 11,6 L 8,10 M 7,1 L 5,11" Stroke="#38BDF8" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ESTÚDIO DE PROJETOS" Foreground="#F8FAFC" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStudioCurrentProject" Text="[Projeto] Shader 2D" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPopoutStudio" Content="Abrir em Janela Cheia" Click="BtnPopoutStudio_Click" Style="{StaticResource StudioAccentButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Abre o Estúdio de Projetos em janela independente maximizada"/>
                    <Button Content="Salvar Imagem" Click="BtnExportImage_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Exporta o buffer atual como PNG"/>
                    <Button Content="Limpar Código" Click="BtnClearCode_Click" Padding="7,4" Margin="0,0,4,0"/>
                    <Button Content="Restaurar Template" Click="BtnResetTemplate_Click" Padding="7,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3 Colunas Redimensionáveis -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="450"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="420" MinWidth="260" MaxWidth="650"/>
            </Grid.ColumnDefinitions>

            <!-- COLUNA 1: Templates & Parâmetros Interativos -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seletor de Resolução -->
                <Border Grid.Row="0" Background="#0E121E" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Resolução do Buffer:" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CbResolution" Grid.Column="1" Width="100" SelectionChanged="CbResolution_SelectionChanged" SelectedIndex="2">
                            <ComboBoxItem Content="128×128" Tag="128"/>
                            <ComboBoxItem Content="256×256" Tag="256"/>
                            <ComboBoxItem Content="512×512" Tag="512"/>
                            <ComboBoxItem Content="1024×1024" Tag="1024"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Templates de Projetos -->
                <GroupBox Grid.Row="1" Header="1. Modelos de Projeto (Templates)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="LstProjectTemplates" Grid.Row="0" Background="#090C16" BorderBrush="#1C2438" BorderThickness="1"
                                 SelectionChanged="LstProjectTemplates_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,5" Margin="0,1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Category}" Foreground="#60A5FA" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="TxtTemplateDesc" Grid.Row="1" Text="Descrição do projeto..." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="15" Margin="2,5,2,0"/>
                    </Grid>
                </GroupBox>

                <!-- Sliders de Parâmetros Interativos -->
                <GroupBox Grid.Row="2" Header="2. Parâmetros Interativos (Tempo Real)">
                    <StackPanel>
                        <Grid Margin="0,1,0,1">
                            <TextBlock x:Name="TxtFreeParam1" Text="Parâmetro 1:" Foreground="#E2E8F0" FontSize="11.5"/>
                            <TextBlock x:Name="TxtFreeVal1" Text="[ 1.0 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderFree1" Minimum="0" Maximum="10" Value="1" SmallChange="0.1" ValueChanged="SliderFree_ValueChanged"/>

                        <Grid Margin="0,1,0,1">
                            <TextBlock x:Name="TxtFreeParam2" Text="Parâmetro 2:" Foreground="#E2E8F0" FontSize="11.5"/>
                            <TextBlock x:Name="TxtFreeVal2" Text="[ 1.0 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderFree2" Minimum="0" Maximum="10" Value="1" SmallChange="0.1" ValueChanged="SliderFree_ValueChanged"/>

                        <Grid Margin="0,1,0,1">
                            <TextBlock x:Name="TxtFreeParam3" Text="Parâmetro 3:" Foreground="#E2E8F0" FontSize="11.5"/>
                            <TextBlock x:Name="TxtFreeVal3" Text="[ 1.0 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderFree3" Minimum="0" Maximum="10" Value="1" SmallChange="0.1" ValueChanged="SliderFree_ValueChanged"/>

                        <Grid Margin="0,1,0,1">
                            <TextBlock x:Name="TxtFreeParam4" Text="Parâmetro 4:" Foreground="#E2E8F0" FontSize="11.5"/>
                            <TextBlock x:Name="TxtFreeVal4" Text="[ 1.0 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderFree4" Minimum="0" Maximum="10" Value="1" SmallChange="0.1" ValueChanged="SliderFree_ValueChanged"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"/>

            <!-- COLUNA 2: Editor Multi-Aba (C#, XAML, Guia) & Console -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="130" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- Toolbar de Ações do Editor -->
                <Border Grid.Row="0" Background="#101422" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="▶ Executar Código" Click="BtnRunCode_Click" Style="{StaticResource StudioExecButton}" Padding="10,5" Margin="0,0,6,0" ToolTip="Compila e renderiza o código C# ou marcação XAML"/>
                            <Border Background="#1E293B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Highlight Automático Ativo" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Ctrl+Enter para Executar" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Editor de Código Multi-Aba -->
                <TabControl x:Name="TabStudioEditor" Grid.Row="1" Background="#080A10" BorderBrush="#1C2438" SelectionChanged="TabStudioEditor_SelectionChanged">
                    <!-- Aba C# -->
                    <TabItem Header="Script C# (.cs)">
                        <Border Background="#06080E" BorderBrush="#1A2030" BorderThickness="1" CornerRadius="4" Padding="6">
                            <RichTextBox x:Name="RtbFreeCode" Background="Transparent" Foreground="#F8FAFC"
                                         BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" AcceptsTab="True" CaretBrush="#38BDF8"
                                         SelectionBrush="#2563EB" SelectionOpacity="0.7"/>
                        </Border>
                    </TabItem>

                    <!-- Aba XAML -->
                    <TabItem Header="Marcação WPF (.xaml)">
                        <Border Background="#06080E" BorderBrush="#1A2030" BorderThickness="1" CornerRadius="4" Padding="6">
                            <RichTextBox x:Name="RtbFreeXamlCode" Background="Transparent" Foreground="#9CDCFE"
                                         BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" AcceptsTab="True" CaretBrush="#38BDF8"
                                         SelectionBrush="#2563EB" SelectionOpacity="0.7"/>
                        </Border>
                    </TabItem>

                    <!-- Aba Guia de Uso & Dicas WPF -->
                    <TabItem Header="Guia &amp; Dicas WPF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <StackPanel>
                                <Border Background="#141E2C" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="GUIA DE USO DO ESTÚDIO DE PROJETOS" Foreground="#60A5FA" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Como criar interfaces WPF, animações e gráficos C# sem erros de compilação ou conflito de namespaces." Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <GroupBox Header="1. Suporte a &lt;Window&gt; e &lt;Canvas&gt; no XAML">
                                    <TextBlock Text="• Você pode colar códigos XAML completos começando com &lt;Window&gt; ou &lt;Grid&gt; ou &lt;Canvas&gt;.&#x0a;• O compilador remove automaticamente atributos 'x:Class' e encapsula os filhos visuais no container ao vivo.&#x0a;• Utilize Viewbox com Canvas para permitir que o desenho se auto-redimensione sem cortes."
                                               Foreground="#E2E8F0" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                                </GroupBox>

                                <GroupBox Header="2. Como Usar Scripts C#">
                                    <TextBlock Text="• No Script C#, você tem acesso direto ao buffer: Output.SetPixel(x, y, cor) ou Output.BackBuffer via ponteiro unsafe.&#x0a;• Os sliders controlam as variáveis Param1, Param2, Param3 e Param4 em tempo real.&#x0a;• Use Print(&quot;mensagem&quot;) para enviar logs ao Console de Saída."
                                               Foreground="#E2E8F0" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                                </GroupBox>

                                <GroupBox Header="3. Exemplo XAML de Formas &amp; Gradientes">
                                    <Border Background="#06080E" Padding="8" CornerRadius="4">
                                        <TextBox Text="&lt;Viewbox Margin=&quot;10&quot;&gt;&#x0a;  &lt;Canvas Width=&quot;400&quot; Height=&quot;300&quot;&gt;&#x0a;    &lt;Rectangle Width=&quot;380&quot; Height=&quot;280&quot; RadiusX=&quot;10&quot; RadiusY=&quot;10&quot; Fill=&quot;#1E293B&quot;/&gt;&#x0a;    &lt;Ellipse Canvas.Left=&quot;150&quot; Canvas.Top=&quot;100&quot; Width=&quot;100&quot; Height=&quot;100&quot; Fill=&quot;#38BDF8&quot;/&gt;&#x0a;  &lt;/Canvas&gt;&#x0a;&lt;/Viewbox&gt;"
                                                 IsReadOnly="True" Background="Transparent" Foreground="#86EFAC" BorderThickness="0" FontFamily="Consolas" FontSize="11.5"/>
                                    </Border>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="2" Height="5" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                <!-- Console de Compilação & Logs -->
                <GroupBox Grid.Row="3" Header="Console de Diagnósticos e Compilação">
                    <TextBox x:Name="TxtFreeConsole" IsReadOnly="True" Background="#06080E" Foreground="#38BDF8" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"/>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center"/>

            <!-- COLUNA 3: Visualizador ao Vivo (Canvas / WPF Nativo) -->
            <Border Grid.Column="4" Background="#080A10" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="5" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TabControl x:Name="TabStudioVisualizer" Grid.Row="0" Background="#06080E" BorderBrush="#1C2438">
                        <TabItem Header="Canvas de Memória DirectBitmap">
                            <Border Background="#04060A" Padding="4">
                                <Image x:Name="ImgFreeSimulation" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </TabItem>
                        <TabItem x:Name="TabItemFreeLiveXaml" Header="WPF Nativo ao Vivo (XAML)">
                            <Border Background="#090C16" Padding="6" CornerRadius="4">
                                <Border x:Name="PnlFreeLiveXamlContainer" BorderBrush="#252F46" BorderThickness="1" CornerRadius="5" Background="#0F1424" Padding="8">
                                    <TextBlock Text="O elemento WPF instanciado será renderizado aqui."
                                               Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="1" Background="#0E121E" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtFreeStats" Text="Pronto. Tempo: 0.0 ms • Resolução: 512×512" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status HUD -->
        <Border Grid.Row="2" Background="#0A0D16" BorderBrush="#1A2234" BorderThickness="0,1,0,0" Padding="8,4" Margin="0,4,0,0">
            <TextBlock x:Name="TxtStudioStatus" Text="Pronto. Estúdio de Projetos carregado." Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
