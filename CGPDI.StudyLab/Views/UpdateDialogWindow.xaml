<Window x:Class="CGPDI.StudyLab.Views.UpdateDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização Disponível — CGPDI StudyLab"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D0E16"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E202E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#33354A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2D40"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#33354A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Changelog -->
            <RowDefinition Height="Auto"/> <!-- Opções de Instalação -->
            <RowDefinition Height="Auto"/> <!-- Barra de Progresso -->
            <RowDefinition Height="Auto"/> <!-- Botões de Ação -->
        </Grid.RowDefinitions>

        <!-- Header com Logo e Versão -->
        <Border Grid.Row="0" Background="#141522" BorderBrush="#25273A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ícone Vetorial -->
                <Viewbox Grid.Column="0" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Path Data="M 32,8 L 54,20 L 32,32 L 10,20 Z" Fill="#38BDF8" Stroke="#67E8F9" StrokeThickness="1.5"/>
                        <Path Data="M 10,20 L 32,32 L 32,56 L 10,44 Z" Fill="#EC4899" Stroke="#F472B6" StrokeThickness="1.5"/>
                        <Path Data="M 32,32 L 54,20 L 54,44 L 32,56 Z" Fill="#FBBF24" Stroke="#FCD34D" StrokeThickness="1.5"/>
                        <Ellipse Canvas.Left="29.5" Canvas.Top="29.5" Width="5" Height="5" Fill="#FFFFFF"/>
                    </Canvas>
                </Viewbox>

                <!-- Textos e Badges -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="Nova Versão Disponível" FontSize="15" FontWeight="Bold" Foreground="#60A5FA"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtVersionCompare" Text="v1.0.0 -> v1.0.1" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                        <Border x:Name="BadgeEnvironment" Visibility="Collapsed" Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtEnvironmentBadge" Text="Zero-Admin" FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtReleaseDate" Text="Publicado no GitHub Releases" FontSize="11.5" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Changelog / Notas de Atualização -->
        <GroupBox Grid.Row="1" Header="O que há de novo nesta versão:" Foreground="#94A3B8" BorderBrush="#25273A" Margin="0,0,0,12" Padding="8">
            <Border Background="#0A0B10" CornerRadius="4" Padding="10,8">
                <FlowDocumentScrollViewer x:Name="ChangelogViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"
                                          Document="{Binding}"
                                          Padding="0"/>
            </Border>
        </GroupBox>

        <!-- Opções de Instalação -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12" VerticalAlignment="Center">
            <StackPanel x:Name="PanelFormat" Orientation="Horizontal">
                <TextBlock Text="Formato:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="RbInstaller" Content="Instalador Automático (.exe)" IsChecked="True" Foreground="#F8FAFC" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbPortable" Content="Versão Portátil (.zip)" Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtDeltaInfo" Visibility="Collapsed" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"
                       Text="Atualização delta: baixa apenas as alterações em relação à versão atual."/>
        </StackPanel>

        <!-- Seção de Progresso do Download -->
        <StackPanel x:Name="PanelProgress" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,14">
            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="TxtProgressStatus" Text="Baixando atualização..." Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Right" Foreground="#60A5FA" FontSize="11.5" FontWeight="Bold"/>
            </Grid>
            <ProgressBar x:Name="PbDownload" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#3B82F6" Background="#1E202E" BorderThickness="0"/>
        </StackPanel>

        <!-- Botões de Ação -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="BtnSkip" DockPanel.Dock="Left" Content="Ignorar esta versão" Style="{StaticResource GhostButton}" Click="BtnSkip_Click" Padding="10,6" FontSize="11"/>
            <Button x:Name="BtnWeb" DockPanel.Dock="Left" Content="Ver no GitHub" Click="BtnWeb_Click" Padding="10,6" Margin="6,0,0,0" FontSize="11"/>
            <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="Lembrar Mais Tarde" Click="BtnCancel_Click" Padding="12,6" Margin="8,0,0,0"/>
            <Button x:Name="BtnApply" DockPanel.Dock="Right" Content="Atualizar Agora" Click="BtnApply_Click" Style="{StaticResource PrimaryButton}" Padding="16,6"/>
        </DockPanel>
    </Grid>
</Window>
