                                    <Border Grid.Row="1" Background="#06060A" BorderBrush="#202030" BorderThickness="1" CornerRadius="4" Padding="6">
                                        <RichTextBox x:Name="RtbTheoryCodeSnippet" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" FontFamily="Consolas, Cascadia Code" FontSize="11.5" VerticalScrollBarVisibility="Auto" AcceptsTab="True" SelectionBrush="#2563EB"/>
