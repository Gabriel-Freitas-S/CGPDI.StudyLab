                            <Image x:Name="ImgDisplay2D" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseDown="ImgDisplay2D_MouseDown"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="3"/>

                    <!-- Painel Teórico & Código 2D -->
                    <TabControl Grid.Column="4" Background="#0C0C12" BorderBrush="#20202C">
                        <TabItem Header="💡 Teoria &amp; Fórmulas">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                                <StackPanel>
                                    <TextBlock x:Name="TxtTheory2DTitle" Text="Algoritmos de Rasterização 2D" FontSize="13" FontWeight="Bold" Foreground="#6588F8" TextWrapping="Wrap"/>
                                    <Border Height="1" Background="#242434" Margin="0,5,0,6"/>
                                    <TextBlock x:Name="TxtTheory2DMath" Text="Selecione um botão à esquerda para traçar primitivas 2D." TextWrapping="Wrap" Foreground="#C6C6D4" FontSize="11.5" LineHeight="17"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="💻 Código C#">
