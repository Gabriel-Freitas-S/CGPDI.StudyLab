                            </Grid>
                        </Border>

                        <!-- Lista de Tópicos de Estudo -->
                        <ListBox x:Name="LstStudyTopics" Grid.Row="1" Background="#12121A" BorderBrush="#242432" BorderThickness="1"
                                 SelectionChanged="LstStudyTopics_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,5" Margin="0,1" CornerRadius="4" ToolTip="{Binding Title}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Category}" Foreground="#8EA6F5" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}" Foreground="#F0F0F8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <GridSplitter Grid.Column="1"/>

                    <!-- Detalhes Teóricos, Fórmulas, Código e Quiz -->
                    <Border Grid.Column="2" Background="#0C0C12" BorderBrush="#20202C" BorderThickness="1" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#161622" BorderBrush="#2D2D42" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtDocCategory" Text="1. FUNDAMENTOS &amp; MEMÓRIA" Foreground="#4F72E8" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtDocTitle" Text="Título do Tópico de Estudo" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,2,0,4" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtDocSummary" Text="Resumo pedagógico e conceitos fundamentais do algoritmo." Foreground="#C4C4D4" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                        <Button x:Name="BtnGoToLaboratorioLesson" Grid.Column="1" Content="▶ Praticar no Laboratório" Click="BtnGoToLaboratorioLesson_Click" Style="{StaticResource PrimaryButton}" Padding="10,6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>

                                <GroupBox Header="1. Formulação Matemática e Teoria">
                                    <TextBlock x:Name="TxtDocMath" Text="Fórmulas e equações matemáticas..." Foreground="#D8D8E8" FontSize="12" TextWrapping="Wrap" LineHeight="19" FontFamily="Consolas, Segoe UI"/>
                                </GroupBox>

                                <GroupBox Header="2. Como Funciona Passo a Passo">
                                    <TextBlock x:Name="TxtDocExplanation" Text="Explicação detalhada do algoritmo..." Foreground="#C8C8D8" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                </GroupBox>

                                <GroupBox Header="3. Implementação em Código C# (Comentado)">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#181824" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Fonte do Código:" Foreground="#A0A0B4" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Content="A-" Click="BtnZoomOutDocCode_Click" Padding="6,2" Margin="0,0,4,0" ToolTip="Diminuir fonte"/>
                                                    <Button Content="A+" Click="BtnZoomInDocCode_Click" Padding="6,2" Margin="0,0,4,0" ToolTip="Aumentar fonte"/>
                                                    <Button Content="100%" Click="BtnResetDocCodeZoom_Click" Padding="6,2" ToolTip="Restaurar tamanho padrão"/>
                                                </StackPanel>
                                                <Button Content="Copiar Código" Click="BtnCopyDocCode_Click" HorizontalAlignment="Right" Padding="8,2" ToolTip="Copiar código C#"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Background="#06060A" BorderBrush="#202030" BorderThickness="1" CornerRadius="4" Padding="8">
                                            <RichTextBox x:Name="RtbDocSnippet" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0"
                                                         BorderThickness="0" FontFamily="Consolas, Cascadia Code" FontSize="13" VerticalScrollBarVisibility="Auto" AcceptsTab="True" SelectionBrush="#2563EB"/>
                                        </Border>
                                    </Grid>
                                </GroupBox>

                                <!-- Quiz de Fixação Interativo -->
                                <GroupBox x:Name="GrpStudyTopicQuiz" Header="4. Quiz de Fixação e Avaliação do Conteúdo">
                                    <StackPanel Margin="2">
                                        <TextBlock x:Name="TxtStudyTopicQuizQuestion" Text="Pergunta do Quiz..." Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <Button x:Name="BtnStudyTopicQuizOpt0" Click="BtnStudyTopicQuizOpt_Click" Tag="0" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="10,6" MinHeight="36">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button x:Name="BtnStudyTopicQuizOpt1" Click="BtnStudyTopicQuizOpt_Click" Tag="1" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="10,6" MinHeight="36">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button x:Name="BtnStudyTopicQuizOpt2" Click="BtnStudyTopicQuizOpt_Click" Tag="2" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="10,6" MinHeight="36">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Border x:Name="BrdStudyTopicQuizFeedback" Visibility="Collapsed" CornerRadius="4" Padding="10,8" Margin="0,6,0,0" Background="#1E2A20" BorderBrush="#2E7D32" BorderThickness="1">
                                            <TextBlock x:Name="TxtStudyTopicQuizFeedback" Text="Feedback..." Foreground="#A5D6A7" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="5. Complexidade Computacional e Otimização">
                                    <TextBlock x:Name="TxtDocComplexity" Text="Complexidade O(N)..." Foreground="#FFD700" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"/>
                                </GroupBox>

                                <GroupBox Header="6. Onde Testar no Software">
                                    <TextBlock x:Name="TxtDocWhereToTest" Text="Localização nas abas..." Foreground="#40E0D0" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </GroupBox>

                                <GroupBox Header="7. Referências Oficiais Microsoft Learn">
                                    <StackPanel>
                                        <ItemsControl x:Name="IcMicrosoftRefs">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#161622" BorderBrush="#2D2D42" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Title}" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Description}" Foreground="#A8A8B8" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Abrir Documentação" Tag="{Binding Url}" Click="BtnOpenMsRef_Click" VerticalAlignment="Center" Padding="8,4"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================================== -->
            <!-- ABA 6: LABORATÓRIO INTERATIVO (C# & WPF GUIADO)                                  -->
            <!-- ================================================================================== -->
            <TabItem x:Name="TabItemLaboratorio">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 4,2 L 1,6 L 4,10 M 8,2 L 11,6 L 8,10 M 7,1 L 5,11" Stroke="#38BDF8" StrokeThickness="1.3" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Laboratório C#/WPF" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar de Layout -->
                    <Border Grid.Row="0" Background="#141420" BorderBrush="#252538" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnToggleLabTrack" Content="Ocultar Trilha" Click="BtnToggleLabTrack_Click" Padding="8,3" FontSize="11.5" ToolTip="Oculta ou exibe a lista de lições e quiz"/>
                                <Button x:Name="BtnTogglePlayground" Content="Ocultar Canvas" Click="BtnTogglePlayground_Click" Padding="8,3" FontSize="11.5" Margin="4,0,0,0" ToolTip="Oculta ou exibe o canvas de simulação"/>
                                <Button x:Name="BtnFocusCode" Content="Modo Foco" Click="BtnFocusCode_Click" Style="{StaticResource PrimaryButton}" Padding="8,3" FontSize="11.5" Margin="4,0,0,0" ToolTip="Maximiza o editor de código em 100% da tela"/>
                                <Button x:Name="BtnResetColumns" Content="Restaurar Painéis" Click="BtnResetColumns_Click" Padding="8,3" FontSize="11.5" Margin="4,0,0,0" ToolTip="Restaura a visualização balanceada de 3 colunas"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Abrir em Janela Separada" Click="BtnOpenPopoutStudio_Click" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11.5" FontWeight="Bold" ToolTip="Abre o Laboratório em janela independente"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Workspace das 3 Colunas: Trilha/Quiz -> Visualizador -> Editor -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColLabTrack" Width="380" MinWidth="0" MaxWidth="550"/>
                            <ColumnDefinition x:Name="ColLabSplitter1" Width="5"/>
                            <ColumnDefinition x:Name="ColLabPlayground" Width="400" MinWidth="0" MaxWidth="650"/>
                            <ColumnDefinition x:Name="ColLabSplitter2" Width="5"/>
                            <ColumnDefinition x:Name="ColLabCode" Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coluna 1: Trilha de Aprendizado + Quiz em Destaque -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="170" MinHeight="100"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Barra de Progresso da Trilha -->
                            <Border Grid.Row="0" Background="#161622" BorderBrush="#2E2E40" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtLessonProgressHeader" Text="Trilha de Estudos (Passo 1 de 12)" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtLessonPercent" Text="8%" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar x:Name="PbLessonProgress" Minimum="1" Maximum="12" Value="1" Height="7" Foreground="#3B82F6" Background="#242436" BorderThickness="0" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="2">
                                        <Button x:Name="BtnPrevLesson" Content="Anterior" Click="BtnPrevLesson_Click" Padding="6,5" FontSize="12"/>
                                        <Button x:Name="BtnNextLesson" Content="Próximo" Click="BtnNextLesson_Click" Style="{StaticResource PrimaryButton}" Padding="6,5" FontSize="12"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Lista de Lições -->
                            <ListBox x:Name="LstInteractiveLessons" Grid.Row="1" Background="#12121A" BorderBrush="#242432" BorderThickness="1" Margin="0,0,0,6"
                                     SelectionChanged="LstInteractiveLessons_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="0,1" CornerRadius="3" ToolTip="{Binding Title}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Module}" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="17"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Quiz Interativo em Destaque (Sem corte de texto) -->
                            <GroupBox Grid.Row="2" Header="Quiz de Fixação (Avaliação do Conceito)">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtQuizQuestion" Text="Pergunta do Quiz..." Foreground="#FFFFFF" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold" LineHeight="18"/>
                                        
                                        <Button x:Name="BtnQuizOpt0" Click="BtnQuizOption_Click" Tag="0" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="8,6" MinHeight="36">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="11.5" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button x:Name="BtnQuizOpt1" Click="BtnQuizOption_Click" Tag="1" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="8,6" MinHeight="36">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="11.5" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button x:Name="BtnQuizOpt2" Click="BtnQuizOption_Click" Tag="2" Margin="0,3" HorizontalContentAlignment="Stretch" Padding="8,6" MinHeight="36">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16" Foreground="#F8FAFC" FontSize="11.5" HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Border x:Name="BrdQuizFeedback" Visibility="Collapsed" CornerRadius="4" Padding="10,8" Margin="0,6,0,6" Background="#1E2A20" BorderBrush="#2E7D32" BorderThickness="1">
                                            <TextBlock x:Name="TxtQuizFeedback" Text="Feedback..." Foreground="#A5D6A7" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                                        </Border>

                                        <Button x:Name="BtnGoToStudyTheory" Content="📖 Ver Teoria Completa deste Tópico" Click="BtnGoToStudyTheory_Click" Padding="8,5" FontSize="11" Margin="0,4,0,4"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </Grid>

                        <GridSplitter x:Name="Splitter1" Grid.Column="1"/>

                        <!-- Coluna 2: Playground & Canvas de Renderização -->
                        <Border Grid.Column="2" Background="#0C0C12" BorderBrush="#20202C" BorderThickness="1" CornerRadius="6" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header da Lição -->
                                    <RowDefinition Height="Auto"/> <!-- Sliders do Playground -->
                                    <RowDefinition Height="*"/>    <!-- Canvas de Renderização -->
                                </Grid.RowDefinitions>

                                <!-- Header da Lição -->
                                <Border Grid.Row="0" Background="#161622" BorderBrush="#2D2D42" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLessonModule" Text="MÓDULO 1: FUNDAMENTOS" Foreground="#60A5FA" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtLessonTitle" Text="Título da Lição Interativa" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" Margin="0,1,0,2"/>
                                        <TextBlock x:Name="TxtLessonSummary" Text="Resumo prático..." Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <!-- Controles do Playground -->
                                <GroupBox Grid.Row="1" Header="Playground Interativo" Margin="0,0,0,6">
                                    <Grid Margin="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                            <Grid Margin="0,1,0,1">
                                                <TextBlock x:Name="TxtLabParam1" Text="Parâmetro 1:" Foreground="#E2E8F0" FontSize="11.5"/>
                                                <TextBlock x:Name="TxtLabVal1" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderLab1" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderLab_ValueChanged" Height="22" Margin="0,0,0,3"/>

                                            <Grid Margin="0,1,0,1">
                                                <TextBlock x:Name="TxtLabParam2" Text="Parâmetro 2:" Foreground="#E2E8F0" FontSize="11.5"/>
                                                <TextBlock x:Name="TxtLabVal2" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderLab2" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderLab_ValueChanged" Height="22" Margin="0,0,0,3"/>

                                            <Grid Margin="0,1,0,1">
                                                <TextBlock x:Name="TxtLabParam3" Text="Parâmetro 3:" Foreground="#E2E8F0" FontSize="11.5"/>
                                                <TextBlock x:Name="TxtLabVal3" Text="[ 128 ]" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderLab3" Minimum="0" Maximum="255" Value="128" ValueChanged="SliderLab_ValueChanged" Height="22" Margin="0,0,0,2"/>
                                        </StackPanel>

                                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,2,0,0">
                                            <Button Content="Passo" Click="BtnStepSimulation_Click" Style="{StaticResource PrimaryButton}" Padding="4,5" FontSize="11" Margin="0,0,2,0"/>
                                            <Button Content="Executar Tudo" Click="BtnRunAllSimulation_Click" Padding="4,5" FontSize="11" Margin="2,0,2,0"/>
                                            <Button Content="Resetar" Click="BtnResetSimulation_Click" Padding="4,5" FontSize="11" Margin="2,0,0,0"/>
                                        </UniformGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- Viewport Duplo (DirectBitmap e WPF Nativo) -->
                                <TabControl x:Name="TabLabVisualizer" Grid.Row="2" Background="#0A0A10" BorderBrush="#242436" Margin="0,2,0,0">
                                    <TabItem Header="Canvas de Memória">
                                        <Border Background="#06060A" Padding="4">
                                            <Image x:Name="ImgLabSimulation" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </TabItem>
                                    <TabItem x:Name="TabItemLabLiveXaml" Header="WPF Nativo ao Vivo">
                                        <Border Background="#0D0D18" Padding="6" CornerRadius="4">
                                            <Border x:Name="PnlLabLiveXamlContainer" BorderBrush="#33334D" BorderThickness="1" CornerRadius="6" Background="#141424" Padding="8">
                                                <TextBlock Text="O controle WPF dinâmico será renderizado aqui." Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>

                        <GridSplitter x:Name="Splitter2" Grid.Column="3"/>

                        <!-- Coluna 3: Editor C# & WPF Interativo, Testes & Gabarito -->
                        <TabControl x:Name="TabLabEditor" Grid.Column="4" Background="#101018" BorderBrush="#2A2A3C">
                            <!-- Aba 1: Editor C# com Roslyn -->
                            <TabItem Header="Código C# (.cs)">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="130" MinHeight="80"/>
                                    </Grid.RowDefinitions>

                                    <!-- Desafio da Lição -->
                                    <Border Grid.Row="0" Background="#141E2C" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="MISSÃO PRÁTICA DO ALUNO:" Foreground="#60A5FA" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtChallengeGoal" Text="Implemente a rotina solicitada..." Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Toolbar -->
                                    <Border Grid.Row="1" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnRunUserCode" Content="Compilar e Executar C#" Click="BtnRunUserCode_Click" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11.5" Margin="0,0,4,2"/>
                                            <Button x:Name="BtnRunTests" Content="Executar Testes" Click="BtnRunTests_Click" Padding="8,4" FontSize="11.5" Margin="0,0,4,2"/>
                                            <Button Content="Carregar Gabarito" Click="BtnRestoreOfficialCode_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                                            <Button Content="Restaurar Template" Click="BtnStarterCode_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                                            <Button Content="Limpar" Click="BtnBlankCode_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                                        </WrapPanel>
                                    </Border>

                                    <!-- RichTextBox Editor C# -->
                                    <Border Grid.Row="2" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                                        <RichTextBox x:Name="RtbLabEditableCode" Background="Transparent" Foreground="#F8FAFC"
                                                     BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                                     VerticalScrollBarVisibility="Auto" AcceptsTab="True" CaretBrush="#38BDF8"
                                                     SelectionBrush="#2563EB" SelectionOpacity="0.7"/>
                                    </Border>

                                    <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch"/>

                                    <!-- Relatório de Testes e Erros Roslyn -->
                                    <GroupBox Grid.Row="4" Header="Relatório de Testes Automatizados e Roslyn">
                                        <TextBox x:Name="TxtCompilerReport" IsReadOnly="True" Background="#06060A" Foreground="#A5D6A7" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"/>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <!-- Aba 2: Marcação WPF / XAML ao Vivo -->
                            <TabItem x:Name="TabItemLabXaml" Header="Marcação WPF (.xaml)">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Renderizar XAML" Click="BtnLabRenderXaml_Click" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11.5" Margin="0,0,4,2"/>
                                            <Button Content="Exemplo Básico" Click="BtnLabXamlTemplateBasic_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                                            <Button Content="Canvas &amp; Formas" Click="BtnLabXamlTemplateShapes_Click" Padding="6,4" FontSize="11" Margin="0,0,4,2"/>
                                            <Button Content="Copiar XAML" Click="BtnLabCopyXaml_Click" Padding="6,4" FontSize="11" Margin="0,0,0,2"/>
                                        </WrapPanel>
                                    </Border>

                                    <Border Grid.Row="1" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                                        <RichTextBox x:Name="RtbLabXamlCode" Background="Transparent" Foreground="#9CDCFE"
                                                     BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                                     VerticalScrollBarVisibility="Auto" AcceptsTab="True" CaretBrush="#38BDF8"
                                                     SelectionBrush="#2563EB" SelectionOpacity="0.7"/>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Aba 3: Estudo e Gabarito Oficial -->
                            <TabItem Header="Estudo e Gabarito">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="2*" MinHeight="120"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="3*" MinHeight="120"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fonte:" Foreground="#A0A0B4" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Content="A-" Click="BtnZoomOutLabCode_Click" Padding="6,2" Margin="0,0,4,0"/>
                                                <Button Content="A+" Click="BtnZoomInLabCode_Click" Padding="6,2" Margin="0,0,4,0"/>
                                            </StackPanel>
                                            <Button Content="Copiar Código C#" Click="BtnCopyLabCode_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                                        <RichTextBox x:Name="RtbLabCode" IsReadOnly="True" Background="Transparent" Foreground="#86EFAC" BorderThickness="0"
                                                     FontFamily="Consolas, Cascadia Code" FontSize="12.5" VerticalScrollBarVisibility="Auto"/>
                                    </Border>

                                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"/>

                                    <GroupBox Grid.Row="3" Header="Explicação Linha a Linha">
                                        <TextBox x:Name="TxtLabExplanation" IsReadOnly="True" Background="#0A0A12" Foreground="#F1F5F9" BorderThickness="0"
                                                 FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"/>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <!-- Aba 4: Console RAM -->
                            <TabItem Header="Console da RAM">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#181824" BorderBrush="#2C2C40" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <Button Content="Copiar Logs" Click="BtnCopyConsole_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/>
                                    </Border>

                                    <Border Grid.Row="1" Background="#06060A" BorderBrush="#202032" BorderThickness="1" CornerRadius="4" Padding="6">
                                        <TextBox x:Name="TxtLabConsole" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================================================================== -->
            <!-- ABA 7: ESTÚDIO DE PROJETOS (C# & WPF DO ZERO)                                     -->
            <!-- ================================================================================== -->
            <TabItem x:Name="TabItemEstudio">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 1,2 L 5,6 L 1,10 M 7,10 L 11,10" Stroke="#10B981" StrokeThickness="1.5" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Estúdio de Projetos" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:ProjectStudioControl x:Name="MainStudioControl"/>
            </TabItem>

        </TabControl>

        <!-- Status Bar / Performance HUD -->
        <Border Grid.Row="2" Background="#14141C" BorderBrush="#242432" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="#7E7E8E" FontSize="11"/>
                    <TextBlock x:Name="TxtStatus" Text="Pronto. Imagem de calibração carregada." Foreground="#40E0D0" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tempo: " Foreground="#7E7E8E" FontSize="11"/>
                    <TextBlock x:Name="TxtExecutionTime" Text="0.0 ms" Foreground="#FFD700" FontSize="11" FontWeight="Bold" Margin="0,0,14,0"/>

                    <TextBlock Text="Resolução: " Foreground="#7E7E8E" FontSize="11"/>
                    <TextBlock x:Name="TxtResolution" Text="512x512 (262.144 px)" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:BorderlessWindow>
