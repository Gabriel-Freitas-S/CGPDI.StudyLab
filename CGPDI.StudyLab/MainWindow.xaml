<views:BorderlessWindow x:Class="CGPDI.StudyLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CGPDI.StudyLab.Views"
        mc:Ignorable="d"
        Title="CGPDI StudyLab — Laboratório Universitário de Computação Gráfica &amp; Processamento Digital de Imagens (2D/3D)"
        Height="850" Width="1350"
        MinHeight="650" MinWidth="950"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Background="#101014"
        Foreground="#E2E2EA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo Dark Moderno para Botões -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#22222D"/>
            <Setter Property="Foreground" Value="#F2F2F8"/>
            <Setter Property="BorderBrush" Value="#353545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#323244"/>
                                <Setter Property="BorderBrush" Value="#4F72E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Botões Primários -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2B4BB5"/>
            <Setter Property="BorderBrush" Value="#456DEB"/>
        </Style>

        <!-- Estilo para Sliders -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>

        <!-- Estilo Completo e de Alto Contraste para ComboBox e ComboBoxItem Dark -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="#22222E"
                    BorderBrush="#38384C"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <!-- Ícone Seta para Baixo -->
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#D0D0E0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2E2E3E"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#4F72E8"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#1A1A26"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#4F72E8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#181822"/>
            <Setter Property="Foreground" Value="#F5F5FA"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="1,1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#323854"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B4BB5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#22222E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#38384C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Name="DropDownBorder"
                                        Background="#181822"
                                        BorderBrush="#38384C"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#707080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#8EA6F5"/>
            <Setter Property="BorderBrush" Value="#262634"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Estilo para GridSplitter -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="5">
                            <Rectangle Width="2" Fill="#282838" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4F72E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Dark Completo para TabControl e TabItem -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#090C16"/>
            <Setter Property="BorderBrush" Value="#1C2438"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#101422"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#1C2438"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#182034"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1A2338"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Top Bar Customizada -->
            <RowDefinition Height="*"/>    <!-- Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar / Performance HUD -->
        </Grid.RowDefinitions>

        <!-- Top Bar Header & Barra de Título Customizada (Unificada) -->
        <Border Grid.Row="0" Background="#12121A" BorderBrush="#222232" BorderThickness="0,0,0,1" Padding="10,5" MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título e Logo Vetorial SVG/XAML -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Viewbox Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="64" Height="64">
                            <Path Data="M 32,8 L 54,20 L 32,32 L 10,20 Z" Fill="#38BDF8" Stroke="#67E8F9" StrokeThickness="1.5"/>
                            <Path Data="M 10,20 L 32,32 L 32,56 L 10,44 Z" Fill="#EC4899" Stroke="#F472B6" StrokeThickness="1.5"/>
                            <Path Data="M 32,32 L 54,20 L 54,44 L 32,56 Z" Fill="#FBBF24" Stroke="#FCD34D" StrokeThickness="1.5"/>
                            <Ellipse Canvas.Left="29.5" Canvas.Top="29.5" Width="5" Height="5" Fill="#FFFFFF"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="CGPDI STUDYLAB" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text=".NET 10 • WPF • GPU" FontSize="10" Foreground="#38BDF8" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Menu Superior Inteligente Contextual (Ações da Aba Ativa) -->
                <StackPanel x:Name="PnlContextualTopActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Preenchido dinamicamente via code-behind conforme a aba selecionada -->
                </StackPanel>

                <!-- Docs, Atualizações e Controle de Janela -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Docs Online" Click="BtnOpenOnlineDocs_Click" Padding="7,3" Margin="0,0,3,0"/>
                    <Button Content="Atualizações" Click="BtnCheckUpdates_Click" Padding="7,3" Margin="0,0,8,0" ToolTip="Verificar novas versões e atualizações no GitHub"/>

                    <Button Content="🗕" Click="BtnMinimize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="#182032" Foreground="#94A3B8" BorderBrush="#252F46" ToolTip="Minimizar"/>
                    <Button x:Name="BtnMaximize" Content="🗖" Click="BtnMaximize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="#182032" Foreground="#94A3B8" BorderBrush="#252F46" ToolTip="Maximizar/Restaurar"/>
                    <Button Content="✕" Click="BtnClose_Click" Width="32" Height="26" Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#991B1B" FontWeight="Bold" ToolTip="Fechar"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control com as 7 Abas Principais -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="#101014" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- ================================================================================== -->
            <!-- ABA 1: PROCESSAMENTO DIGITAL DE IMAGENS (PDI)                                     -->
            <!-- ================================================================================== -->
            <TabItem x:Name="TabItemPdi">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 1,1 L 11,1 L 11,11 L 1,11 Z M 3,4 A 1,1 0 1,1 3,3.9 Z M 2,10 L 5,6 L 8,9 L 9,7 L 11,10 Z" Fill="#38BDF8" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Processamento de Imagens (PDI)" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" MinWidth="250" MaxWidth="450"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="340" MinWidth="260" MaxWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- Painel Esquerdo: Controles PDI -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- 1. Modelos de Cor & Canais -->
                            <GroupBox Header="1. Modelos de Cor &amp; Canais">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Button Content="Cinza (BT.709 sRGB)" Click="BtnGrayscaleBt709_Click"/>
                                        <Button Content="Cinza (BT.601 NTSC)" Click="BtnGrayscaleBt601_Click"/>
                                        <Button Content="Cinza (Média)" Click="BtnGrayscaleAverage_Click"/>
                                        <Button Content="Cinza (Desaturação)" Click="BtnGrayscaleLightness_Click"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="3" Margin="0,3,0,0">
                                        <Button Content="Canal R" Click="BtnChannelRed_Click"/>
                                        <Button Content="Canal G" Click="BtnChannelGreen_Click"/>
                                        <Button Content="Canal B" Click="BtnChannelBlue_Click"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,3,0,0">
                                        <Button Content="Sépia Fotográfico" Click="BtnSepia_Click"/>
                                        <Button Content="Inversão Negativa" Click="BtnInvert_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 2. Operações Pontuais -->
                            <GroupBox Header="2. Operações Pontuais">
                                <StackPanel>
                                    <TextBlock Text="Brilho (Delta):" Foreground="#A8A8B8" FontSize="11"/>
                                    <Slider x:Name="SliderBrightness" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="10" ValueChanged="SliderPointOp_ValueChanged"/>

                                    <TextBlock Text="Contraste Linear (Alpha):" Foreground="#A8A8B8" FontSize="11"/>
                                    <Slider x:Name="SliderContrast" Minimum="0.1" Maximum="3.0" Value="1.0" SmallChange="0.1" ValueChanged="SliderPointOp_ValueChanged"/>

                                    <TextBlock Text="Correção Gamma (Power-Law):" Foreground="#A8A8B8" FontSize="11"/>
                                    <Slider x:Name="SliderGamma" Minimum="0.2" Maximum="3.0" Value="1.0" SmallChange="0.05" ValueChanged="SliderPointOp_ValueChanged"/>

                                    <UniformGrid Columns="2" Margin="0,3,0,0">
                                        <Button Content="Posterizar (4 Níveis)" Click="BtnPosterize_Click"/>
                                        <Button Content="Solarizar (Sabattier)" Click="BtnSolarize_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 3. Processamento de Histograma -->
                            <GroupBox Header="3. Processamento de Histograma">
                                <StackPanel>
                                    <Button Content="Equalização Global (HSV)" Click="BtnEqualizeHsv_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="Equalização RGB Independente" Click="BtnEqualizeRgb_Click"/>
                                    <Button Content="Expansão de Contraste (Min-Max)" Click="BtnContrastStretch_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 4. Filtros Espaciais (Convoluções) -->
                            <GroupBox Header="4. Filtros Espaciais (Convoluções)">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Button Content="Box Blur 3x3" Click="BtnBoxBlur3_Click"/>
                                        <Button Content="Box Blur 5x5" Click="BtnBoxBlur5_Click"/>
                                        <Button Content="Gaussiano 3x3" Click="BtnGaussian3_Click"/>
                                        <Button Content="Gaussiano 5x5 (σ=1.4)" Click="BtnGaussian5_Click"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,3,0,0">
                                        <Button Content="Nitidez (Sharpen)" Click="BtnSharpen_Click"/>
                                        <Button Content="Unsharp Masking" Click="BtnUnsharpMask_Click"/>
                                        <Button Content="Mediana 3x3" Click="BtnMedian_Click"/>
                                        <Button Content="Relevo 3D (Emboss)" Click="BtnEmboss_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 5. Detecção de Bordas & Gradientes -->
                            <GroupBox Header="5. Detecção de Bordas &amp; Gradientes">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Button Content="Sobel (Magnitude)" Click="BtnSobelMagnitude_Click"/>
                                        <Button Content="Sobel (Gx Horizontal)" Click="BtnSobelGx_Click"/>
                                        <Button Content="Sobel (Gy Vertical)" Click="BtnSobelGy_Click"/>
                                        <Button Content="Scharr (Otimizado)" Click="BtnScharr_Click"/>
                                        <Button Content="Laplaciano 3x3" Click="BtnLaplacian_Click"/>
                                        <Button Content="Laplaciano Gauss (LoG)" Click="BtnLoG_Click"/>
                                    </UniformGrid>
                                    <Button Content="⭐ Canny Edge Detector Completo" Click="BtnCanny_Click" Style="{StaticResource PrimaryButton}" Margin="2,4,2,2"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 6. Morfologia & Segmentação -->
                            <GroupBox Header="6. Morfologia &amp; Segmentação">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Button Content="Limiarização Otsu Auto" Click="BtnOtsu_Click" Style="{StaticResource PrimaryButton}"/>
                                        <Button Content="Limiarização Adaptativa" Click="BtnAdaptiveThreshold_Click"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,3,0,0">
                                        <Button Content="Erosão 3x3" Click="BtnErosion_Click"/>
                                        <Button Content="Dilatação 3x3" Click="BtnDilation_Click"/>
                                        <Button Content="Abertura (Opening)" Click="BtnOpening_Click"/>
                                        <Button Content="Fechamento (Closing)" Click="BtnClosing_Click"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,3,0,0">
                                        <Button Content="Gradiente Morfológico" Click="BtnMorphGradient_Click"/>
                                        <Button Content="Top-Hat (Cartola Branca)" Click="BtnTopHat_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 7. Transformações Geométricas 2D -->
                            <GroupBox Header="7. Transformações Geométricas 2D">
                                <StackPanel>
                                    <TextBlock Text="Método de Interpolação:" Foreground="#A8A8B8" FontSize="11"/>
                                    <ComboBox x:Name="CmbInterpolation" SelectedIndex="1">
                                        <ComboBoxItem Content="Vizinho Mais Próximo (Nearest)"/>
                                        <ComboBoxItem Content="Interpolação Bilinear (Bilinear)"/>
                                        <ComboBoxItem Content="Interpolação Bicúbica (Bicubic Spline)"/>
                                    </ComboBox>
                                    <UniformGrid Columns="2">
                                        <Button Content="Rotacionar +45°" Click="BtnRotate45_Click"/>
                                        <Button Content="Rotacionar +90°" Click="BtnRotate90_Click"/>
                                        <Button Content="Zoom In (1.5x)" Click="BtnScaleUp_Click"/>
                                        <Button Content="Zoom Out (0.7x)" Click="BtnScaleDown_Click"/>
                                        <Button Content="Cisalhamento (Shear)" Click="BtnShear_Click"/>
                                        <Button Content="Espelhar Horizontal" Click="BtnFlipH_Click"/>
                                    </UniformGrid>
                                    <TextBlock Text="Distorções Não-Lineares:" Foreground="#A8A8B8" FontSize="11" Margin="0,4,0,2"/>
                                    <UniformGrid Columns="3">
                                        <Button Content="Redemoinho" Click="BtnSwirl_Click"/>
                                        <Button Content="Ondas" Click="BtnWave_Click"/>
                                        <Button Content="Olho Peixe" Click="BtnFisheye_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 8. Frequência, Ruído & Fractais -->
                            <GroupBox Header="8. Frequência, Ruído &amp; Fractais">
                                <StackPanel>
                                    <Button Content="Transformada de Fourier (2D DFT)" Click="BtnFourierSpectrum_Click" Style="{StaticResource PrimaryButton}"/>
                                    <UniformGrid Columns="2" Margin="0,3,0,0">
                                        <Button Content="Terreno fBm (Perlin)" Click="BtnPerlinFbm_Click"/>
                                        <Button Content="Ruído Voronoi Celular" Click="BtnVoronoi_Click"/>
                                        <Button Content="Fractal Mandelbrot" Click="BtnMandelbrot_Click"/>
                                        <Button Content="Fractal Julia Set" Click="BtnJulia_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1"/>

                    <!-- Viewport Central da Imagem PDI -->
                    <Border Grid.Column="2" Background="#0A0A0E" BorderBrush="#20202C" BorderThickness="1" CornerRadius="6" Padding="6">
                        <Grid>
                            <Image x:Name="ImgDisplay" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="3"/>

                    <!-- Painel Direito: Histograma + Teoria & Código C# -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="170" MinHeight="130"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Gráfico de Histograma -->
                        <GroupBox Grid.Row="0" Header="📊 Histograma de Cores em Tempo Real">
                            <Grid Background="#0A0A10">
                                <Canvas x:Name="CanvasHistogram" Margin="4" SizeChanged="CanvasHistogram_SizeChanged"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                                    <TextBlock Text="● R " Foreground="#FF5555" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="● G " Foreground="#55FF55" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="● B " Foreground="#5599FF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="● Lum" Foreground="#DDDDDD" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- TabControl Teoria & Código C# -->
                        <TabControl Grid.Row="1" Background="#0C0C12" BorderBrush="#20202C" Margin="0,4,0,0">
                            <TabItem Header="💡 Teoria &amp; Fórmulas">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtTheoryTitle" Text="Selecione um Algoritmo de PDI" FontSize="13" FontWeight="Bold" Foreground="#6588F8" TextWrapping="Wrap"/>
                                        <Border Height="1" Background="#242434" Margin="0,5,0,6"/>
