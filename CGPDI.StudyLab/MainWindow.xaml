                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="340" MinWidth="260" MaxWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- Controles 2D -->
