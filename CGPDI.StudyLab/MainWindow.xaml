                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Busca: " Foreground="#8EA6F5" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSearchStudy" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
