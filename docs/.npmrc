# ==============================================================================
# CGPDI.StudyLab — Configuração de Segurança contra Ataques na Cadeia npm
# ==============================================================================

# 1. BLOQUEIO DE EXECUÇÃO DE SCRIPTS MALICIOSOS (RCE / INFOSTEALERS)
# Desativa execução de lifecycle scripts (preinstall, postinstall, prepare) de pacotes terceiros.
ignore-scripts=true

# 2. FIXAÇÃO EXATA DE VERSÕES (ANTI-POISONING / ANTI-TYPOSQUATTING)
# Garante que pacotes adicionados sejam gravados com versão exata (sem ^ ou ~).
save-exact=true

# 3. INTEGRIDADE E REPRODUTIBILIDADE DO LOCKFILE
# Obriga a geração e respeito estrito ao package-lock.json.
package-lock=true

# 4. REGISTRY OFICIAL E SEGURO
# Impede redirecionamento para registries não oficiais ou comprometidos.
registry=https://registry.npmjs.org/

# 5. AUDITORIA AUTOMÁTICA DE VULNERABILIDADES
# Realiza verificação de vulnerabilidades em cada instalação e falha em nível alto/crítico.
audit=true
audit-level=high

# 6. VALIDAÇÃO ESTRITA DE ENGINE NODE/NPM
# Falha a instalação se o ambiente estiver em versão de Node incompatível/vulnerável.
engine-strict=true

# 7. REDUÇÃO DE TELEMETRIA
fund=false
